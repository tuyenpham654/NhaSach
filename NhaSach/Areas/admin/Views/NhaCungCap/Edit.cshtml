@model NhaSach.Models.NHACUNGCAP
@{
    ViewBag.Title = "Nhà Cung Cấp";
    Layout = "~/Areas/admin/Views/Shared/_Layout.cshtml";
}

<h2>Edit</h2>

<form action="~/admin/NhaCungCap/Edit" method="post">
    <div class="form-group">

        <input type="hidden" value="@Model.MaNCC" class="form-control" id="MaNCC" name="MaNCC" />

    </div>

    <div class="form-group">
        <label for="TenNCC">Tên Nhà Cung Cấp</label>
        <input type="text" value="@Model.TenNCC" class="form-control" id="TenNCC" name="TenNCC" />

    </div>
    <div class="form-group">
        <label for="SDT">Liên Hệ</label>
        <input type="text" value="@Model.SDT" class="form-control" id="SDT" name="SDT" />

    </div>
    

    <div class="form-group">
        <button type="submit" class="btn btn-success" value="Lưu">Lưu</button>
        <span class="text-danger">@ViewBag.StatusMessage</span>

    </div>

</form>