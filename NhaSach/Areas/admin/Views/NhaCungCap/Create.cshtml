@model NhaSach.Models.NHACUNGCAP
@{
    ViewBag.Title = "Nhà Cung Cấp";
    Layout = "~/Areas/admin/Views/Shared/_Layout.cshtml";
}

<h2>Create</h2>

<form action="~/admin/NhaCungCap/Create" method="post">
    <div class="form-group">
        <label for="MaNCC">Mã Nhà Cung Cấp</label>
        <input type="text" class="form-control" id="MaNCC" name="id" disabled />
    </div>
    <div class="form-group">
        <label for="TenNCC">Tên Nhà Cung Cấp</label>
        <input type="text" class="form-control" id="TenNCC" name="TenNCC" />

    </div>
    <div class="form-group">
        <label for="SDT">Liên Hệ</label>
        <input type="text" class="form-control" id="SDT" name="SDT" />

    </div>
    

    <div class="form-group">
        <button type="submit" class="btn btn-success" value="Lưu">Lưu</button>
        <span class="text-danger">@ViewBag.StatusMessage</span>

    </div>

    <div>

        @Html.ActionLink("Quay về danh sách", "Index")
    </div>


</form>