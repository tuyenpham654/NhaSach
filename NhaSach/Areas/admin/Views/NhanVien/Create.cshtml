@model NhaSach.Models.NHANVIEN
@{
    ViewBag.Title = "Nhân Viên";
    Layout = "~/Areas/admin/Views/Shared/_Layout.cshtml";
}

<h2>Create</h2>

<form action="~/admin/NhanVien/Create" method="post">
    <div class="form-group">
        <label for="MaNV">Mã Sản Phẩm</label>
        <input type="text" class="form-control" id="MaNV" name="id" disabled/>
    </div>
    <div class="form-group">
        <label for="TenNV">Tên Nhân Viên</label>
        <input type="text" class="form-control" id="TenNV" name="TenNV" />

    </div>
    <div class="form-group">
        <label for="GioiTinh">Giới Tính</label>
        <input type="text" class="form-control" id="GioiTinh" name="GioiTinh" />

    </div>
    <div class="form-group">
        <label for="SDT">Liên Hệ</label>
        <input type="text" class="form-control" id="SDT" name="SDT" />

    </div>
    <div class="form-group">
        <label for="DiaChi">Địa Chỉ</label>
        <input type="text" class="form-control" id="DiaChi" name="DiaChi" />

    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-success" value="Lưu">Lưu</button>
        <span class="text-danger">@ViewBag.StatusMessage</span>

    </div>

    <div>

        @Html.ActionLink("Quay về danh sách", "Index")
    </div>


</form>