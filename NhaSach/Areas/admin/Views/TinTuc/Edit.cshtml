@model NhaSach.Models.TINTUC
@{
    ViewBag.Title = "Tin Tức";
    Layout = "~/Areas/admin/Views/Shared/_Layout.cshtml";
}

 

<form action="~/admin/TinTuc/Edit" method="post" enctype="multipart/form-data">
    <div class="form-group">

        <input type="hidden" value="@Model.ID" class="form-control" id="ID" name="ID" />

    </div>

    <div class="form-group">
        <label for="LoaiTinTuc">Loại Tin Tức</label>
        <input type="text" value="@Model.LoaiTinTuc" class="form-control" id="LoaiTinTuc" name="LoaiTinTuc" />

    </div>
    <div class="form-group">
        <label for="NoiDung">Nội Dung</label>
        <input type="text" value="@Model.NoiDung" class="form-control" id="NoiDung" name="NoiDung" />

    </div>
    <div class="form-group">
        <label for="TenTinTuc">Tên Tin Tức</label>
        <input type="text" value="@Model.TenTinTuc" class="form-control" id="TenTinTuc" name="TenTinTuc" />

    </div>
    <div class="form-group">
        <label >Hình ảnh</label>
        <input type="file" id="uploadhinh" name="uploadhinh" accept="image/*" />
    </div>

    



    <div class="form-group">
        <button type="submit" class="btn btn-success" value="Lưu">Lưu</button>
        <span class="text-danger">@ViewBag.StatusMessage</span>

    </div>

</form>