@model NhaSach.Models.HOADON
@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/admin/Views/Shared/_Layout.cshtml";
}

<h2>Edit</h2>

<form action="~/admin/HoaDon/Edit" method="post">
    <div class="form-group">

        <input type="hidden" value="@Model.MaHD" class="form-control" id="MaHD" name="MaHD" />

    </div>

    <div class="form-group">
        <label for="NgayLap">Ngày Lập</label>
        <input type="text" value="@Model.NgayLap" class="form-control" id="NgayLap" name="TenSP" />

    </div>
    <div class="form-group">
        <label for="TongGT">Tổng Giá Trị</label>
        <input type="text" value="@Model.TongGT" class="form-control" id="TongGT" name="TongGT" />

    </div>
    <div class="form-group">
        <label for="MaKH">Khách Hàng</label>
        <input type="text" value="@Model.MaKH" class="form-control" id="MaKH" name="MaKH" />

    </div>
   



    <div class="form-group">
        <button type="submit" class="btn btn-success" value="Lưu">Lưu</button>
        <span class="text-danger">@ViewBag.StatusMessage</span>

    </div>

</form>