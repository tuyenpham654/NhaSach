@model NhaSach.Models.KHACHHANG
@{
    ViewBag.Title = "Khách Hàng";
    Layout = "~/Areas/admin/Views/Shared/_Layout.cshtml";
}

<h2>Edit</h2>
<form class="table" action="~/admin/KhachHang/Edit" method="post">
    <div class="form-group">

        <input type="hidden" value="@Model.ID" class="form-control" id="ID" name="ID" />

    </div>

    <div class="form-group">
        <label for="TenLoai">Tên Khách Hàng</label>
        <input type="text" value="@Model.TenKH" class="form-control" id="TenKH" name="TenKH" />

    </div>
    <div class="form-group">
        <label for="GhiChu">Số CMND</label>
        <input type="text" value="@Model.CMND" class="form-control" id="CMND" name="CMND" />
    </div>
    <div class="form-group">
        <label for="GhiChu">Giới Tính</label>
        <input type="text" value="@Model.GioiTinh" class="form-control" id="GioiTinh" name="GioiTinh" />
    </div>
    <div class="form-group">
        <label for="UserName">Tên Tài Khoản Khách Hàng</label>
        <input type="text" value="@Model.UserName" class="form-control" id="UserName" name="UserName" />
    </div>
    <div class="form-group">
        <label for="GNgaySinh">Ngày Sinh</label>
        <input type="text" value="@Model.NgaySinh" class="form-control" id="NgaySinh" name="NgaySinh" />
    </div>
    <div class="form-group">
        <label for="NgayLap">Ngày Lập Khách Hàng</label>
        <input type="text" value="@Model.NgayLap" class="form-control" id="NgayLap" name="NgayLap" />
    </div>
    <div class="form-group">
        <label for="DiaChi">Địa Chỉ</label>
        <input type="text" value="@Model.DiaChi" class="form-control" id="DiaChi" name="DiaChi" />
    </div>




    <div class="form-group">
        <button type="submit" class="btn btn-success" value="Lưu">Lưu</button>
        <span class="text-danger">@ViewBag.StatusMessage</span>

    </div>

</form>

