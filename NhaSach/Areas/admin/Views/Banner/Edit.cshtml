@model NhaSach.Models.BANNER
@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/admin/Views/Shared/_Layout.cshtml";
}

<h2>Edit</h2>
<form action="~/admin/Banner/Edit" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label >ID</label>
        <input type="hidden" value="@Model.ID" class="form-control" id="ID" name="ID"  />
    </div>

    <div class="form-group">
        <label>Nội Dung</label>
        <input type="text" value="@Model.Noidung" class="form-control" id="Noidung" name="Noidung" />

    </div>
    <div class="form-group">
        <label>Tình trạng</label>
        <input type="text" value="@Model.TinhTrang" class="form-control" id="TinhTrang" name="TinhTrang" />

    </div>
    <div class="form-group">
        <label>Hình ảnh</label>
        <input type="file"  id="uploadhinh" name="uploadhinh" accept="image/*" />
    </div>




    <div class="form-group">
        <button type="submit" class="btn btn-success" value="Lưu">Lưu</button>
        <span class="text-danger">@ViewBag.StatusMessage</span>

    </div>

    <div>

        @Html.ActionLink("Quay về danh sách", "Index")
    </div>


</form>

