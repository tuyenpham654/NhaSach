@model IEnumerable<NhaSach.Models.BANNER>
@{
    ViewBag.Title = "Banner";
    Layout = "~/Areas/admin/Views/Shared/_Layout.cshtml";
}


<div>
    <form action="~/admin/Banner/Index" method="post">
        <div>
            <a class="btn btn-primary" href="~/admin/Banner/Create">Thêm Mới</a>
        </div>
    </form>
    <div>
        <table class="table table table-hover">
            <thead>
            <td>ID</td>
            <td>Nội Dung</td>
            <td>Tình trạng</td>
            <td>Hình ảnh</td>
            <td>Sửa</td>
            <td>Xóa</td>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ID</td>
                        <td>@item.Noidung</td>
                        <td>@item.TinhTrang</td>
                        <td><img style="width:50px; height:50px" src="~/Upload/Banner/@item.HinhBN" /></td>
                        <td><a href="~/admin/Banner/Edit/@item.ID">Sửa</a></td>
                        <td><a href="~/admin/Banner/Delete/@item.ID">Xóa</a></td>
                    </tr>
                }

            </tbody>

        </table>
    </div>

</div>
