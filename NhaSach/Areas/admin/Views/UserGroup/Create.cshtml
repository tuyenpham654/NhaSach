@model NhaSach.Models.USERGROUP
@{
    ViewBag.Title = "Nhóm Account";
    Layout = "~/Areas/admin/Views/Shared/_Layout.cshtml";
}

<h2>Create</h2>

<form action="~/admin/UserGroup/Create" method="post">
    <div class="form-group">
        <label for="ID">ID</label>
        <input type="text" class="form-control" id="ID" name="ID" readonly />
    </div>

    <div class="form-group">
        <label for="Name">Tên</label>
        <input type="text" class="form-control" id="Name" name="Name" />

    </div>
    

    <div class="form-group">
        <button type="submit" class="btn btn-success" value="Lưu">Lưu</button>
        <span class="text-danger">@ViewBag.StatusMessage</span>

    </div>

    <div>

        @Html.ActionLink("Quay về danh sách", "Index")
    </div>


</form>