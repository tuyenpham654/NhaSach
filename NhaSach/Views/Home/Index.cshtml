                <!-- hình ảnh cuối gần footer -->

                <div class="onehalf-add-shope zoom-img">
                    <a href="#"><img style="height:100px;width:155px " src="~/Upload/TinTuc/@item.Hinh" alt="shope-add" />@item.TenTinTuc</a>
